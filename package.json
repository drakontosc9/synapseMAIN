{
  "name": "synapse",
  "version": "0.1.0",
  "description": "A mind-mapping app: capture a thought, it auto-files into a Markdown vault, and you navigate everything through an Obsidian-style graph.",
  "main": "main.js",
  "author": "Ivan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/classifier.test.js && node test/features.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ivan.synapse",
    "productName": "Synapse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "classifier.js",
      "vault.js",
      "fm.js",
      "rules.json",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Synapse",
      "uninstallDisplayName": "Synapse"
    }
  }
}
