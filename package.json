{
  "name": "synapse",
  "version": "0.3.1",
  "description": "A mind-mapping app: capture a thought, it auto-files into a Markdown vault, and you navigate everything through an Obsidian-style graph.",
  "main": "main.js",
  "author": "Ivan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/classifier.test.js && node test/features.test.js && node test/safeio.test.js && node test/vault-async.test.js && node test/split.test.js",
    "test:ui": "electron test/ui-smoke.js",
    "test:ipc": "electron test/ipc-live.js",
    "test:stress": "electron test/stress.js 2500",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ivan.synapse",
    "productName": "Synapse",
    "publish": [
      {
        "provider": "github",
        "owner": "drakontosc9",
        "repo": "synapseMAIN"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "**/*",
      "!test/**",
      "!.github/**",
      "!dist/**",
      "!*.md",
      "!.gitattributes",
      "!.gitignore"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Synapse",
      "uninstallDisplayName": "Synapse"
    }
  }
}
